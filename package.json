{
  "name": "brat-codex",
  "version": "1.0.0",
  "description": "Production ready Brat style image, sticker, video and animated sticker generation library for WhatsApp Bot developers.",
  "main": "index.js",
  "module": "index.mjs",
  "types": "index.d.ts",
  "type": "commonjs",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./index.mjs",
      "require": "./index.js",
      "default": "./index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "index.mjs",
    "index.d.ts",
    "src",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "postinstall": "node scripts/fetch-assets.js || true",
    "test": "node test/run.js"
  },
  "keywords": [
    "brat",
    "brat-generator",
    "brat-image",
    "brat-sticker",
    "brat-video",
    "whatsapp-sticker",
    "whatsapp-bot",
    "baileys",
    "sticker-maker",
    "image-generator",
    "canvas",
    "meme-generator",
    "text-to-image"
  ],
  "author": "Fidzz",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fidzz/brat-codex.git"
  },
  "homepage": "https://github.com/fidzz/brat-codex#readme",
  "bugs": {
    "url": "https://github.com/fidzz/brat-codex/issues"
  },
  "funding": {
    "type": "individual",
    "url": "https://github.com/sponsors/fidzz"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "@napi-rs/canvas": "^0.1.53",
    "sharp": "^0.33.4",
    "ffmpeg-static": "^5.2.0",
    "opentype.js": "^1.3.4",
    "twemoji-parser": "^14.0.0"
  },
  "devDependencies": {},
  "publishConfig": {
    "access": "public"
  }
}
